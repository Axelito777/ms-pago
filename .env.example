# Copia a .env y completa. Sin valores reales en el repo.
SPRING_PROFILES_ACTIVE=prod
# Los 3 brokers por el listener EXTERNAL (KAFKA_PUBLIC_HOST de kafka-infra)
KAFKA_BOOTSTRAP_SERVERS=kafka-host:9092,kafka-host:9093,kafka-host:9094
# Máximo (ms) que se espera a Kafka al publicar; si se supera, el pago responde igual
KAFKA_MAX_BLOCK_MS=3000
# Antifraude: más de FRAUD_MAX_ATTEMPTS intentos por tarjeta en FRAUD_WINDOW_SECONDS => bloqueo
FRAUD_WINDOW_SECONDS=10
FRAUD_MAX_ATTEMPTS=3
FRAUD_CLEANUP_INTERVAL_MS=60000
# Credenciales H2 (opcionales)
DB_USERNAME=sa
DB_PASSWORD=
# Azure Entra ID (identificadores públicos; por defecto ya vienen los del proyecto)
AZURE_TENANT_ID=tu-tenant-id
AZURE_CLIENT_ID=tu-client-id-de-la-api
